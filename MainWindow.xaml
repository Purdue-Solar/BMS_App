                                    </StackPanel>
                                    <StackPanel Orientation="Vertical">
                                        <TextBlock x:Name="PrechargeIndexInd" Text="X" Margin="12" FontWeight="ExtraBold" Foreground="Red"/>
                                        <TextBlock x:Name="PrechargeFlagInd" Text="X" Margin="12" FontWeight="ExtraBold" Foreground="Red"/>
                                        <TextBlock x:Name="PrechargeHoldDelayInd" Text="X" Margin="12" FontWeight="ExtraBold" Foreground="Red"/>
                                        <TextBlock x:Name="PrechargeHoldDutyInd" Text="X" Margin="12" FontWeight="ExtraBold" Foreground="Red"/>
                                        <TextBlock x:Name="PrechargePullDutyInd" Text="X" Margin="12" FontWeight="ExtraBold" Foreground="Red"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <StackPanel Orientation="Vertical">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <CheckBox x:Name="PreChargeDelayCheckBox" Checked="PreChargeDelayCheckBox_Checked"  Unchecked="PreChargeDelayCheckBox_Unchecked"  Margin="0,0,-100,0" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Precharge Delay" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10"/>
                                </StackPanel>
                                
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <CheckBox x:Name="PWMFreqCheckBox" Checked="PWMFreqCheckBox_Checked"  Unchecked="PWMFreqCheckBox_Unchecked"  Margin="0,0,-100,-15" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Contactor PWM Frequency" VerticalAlignment="Center" HorizontalAlignment="Center" HorizontalTextAlignment="Center" Margin="10,15,10,0"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Orientation="Vertical">
                                <TextBox x:Name="BoxPreChargeDelay" KeyDown="PreChargeDelay_KeyDown" TextChanged="PreChargeDelay_TextChanged" PlaceholderText="Can Be Float" Margin="5"/>
                                <TextBox x:Name="BoxContactorPWMFreq" KeyDown="ContactorPWMFreq_KeyDown" TextChanged="ContactorPWMFreq_TextChanged" PlaceholderText="Integer Value" Margin="5"/>
                            </StackPanel>
                            <StackPanel Orientation="Vertical">
                                <TextBlock x:Name="PreChargeDelayInd" Text="X" Margin="12" FontWeight="ExtraBold" Foreground="Red"/>
                                <TextBlock x:Name="ContactorPWMFreqInd" Text="X" Margin="12" FontWeight="ExtraBold" Foreground="Red"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </TabViewItem>

                <TabViewItem Header="CHARACTERs CONFIGURATION" HorizontalContentAlignment="Center" Background="Gray" Foreground="White" IsClosable="False">
                    <StackPanel>
                        <TextBlock Text="Characterization Configuration" Foreground="AntiqueWhite" FontWeight="Bold" FontSize="30" HorizontalAlignment="Center"/>
                        <TabView HorizontalAlignment="Center" IsAddTabButtonVisible="True" TabCloseRequested="TabCloseRequested" AddTabButtonClick="TableTabAddRequested">
                            <TabViewItem Header="PACK TOPOLOGY" HorizontalAlignment="Center" HorizontalContentAlignment="Center" Background="Gray" Foreground="White" IsClosable="False">
                                <TabView HorizontalAlignment="Center" IsAddTabButtonVisible="True" TabCloseRequested="TabCloseRequested" AddTabButtonClick="ModuleTabAddRequested">
                                    <TabViewItem Header="OVERVIEW" HorizontalContentAlignment="Center" IsClosable="False">
                                        <StackPanel Orientation="Vertical">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <TextBlock Text="Active?" Margin="0,5,0,0"/>
                                                <CheckBox x:Name="PackTopoCheckBox" Checked="PackTopoCheckBox_Checked"  Unchecked="PackTopoCheckBox_Unchecked"  Margin="10,0,-90,0" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <StackPanel Orientation="Vertical">
                                                    <TextBlock Text="Number of Cell Groups" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10"/>
                                                    <TextBlock Text="Number of Parallel&#10; Cells" VerticalAlignment="Center" HorizontalAlignment="Center" HorizontalTextAlignment="Center" Margin="10,6,10,0"/>
                                                    <TextBlock Text="Number of Series&#10; Cells" VerticalAlignment="Center" HorizontalAlignment="Center" HorizontalTextAlignment="Center" Margin="10,5,10,0"/>
                                                    <TextBlock Text="Reserved" HorizontalTextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10,15,10,0"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Vertical">
                                                    <TextBox x:Name="BoxPackTopoCellGroups" KeyDown="PackTopoCellGroups_KeyDown" TextChanged="PackTopoCellGroups_TextChanged" PlaceholderText="Values" Margin="5"/>
                                                    <TextBox x:Name="BoxPackTopoParallel" KeyDown="PackTopoParallel_KeyDown" TextChanged="PackTopoParallel_TextChanged" PlaceholderText="Values" Margin="5"/>
                                                    <TextBox x:Name="BoxPackTopoSeries" KeyDown="PackTopoSeries_KeyDown" TextChanged="PackTopoSeries_TextChanged" PlaceholderText="Values" Margin="5"/>
                                                    <TextBox x:Name="BoxPackTopoReserved" KeyDown="PackTopoReserved_KeyDown" TextChanged="PackTopoReserved_TextChanged" PlaceholderText="Values" Margin="5"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Vertical">
                                                    <TextBlock x:Name="PackTopoCellGroupsInd" Text="X" Margin="12" FontWeight="ExtraBold" Foreground="Red"/>
                                                    <TextBlock x:Name="PackTopoParallelInd" Text="X" Margin="12" FontWeight="ExtraBold" Foreground="Red"/>
                                                    <TextBlock x:Name="PackTopoSeriesInd" Text="X" Margin="12" FontWeight="ExtraBold" Foreground="Red"/>
                                                    <TextBlock x:Name="PackTopoReservedInd" Text="X" Margin="12" FontWeight="ExtraBold" Foreground="Red"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>
                                    </TabViewItem>
                                </TabView>
                            </TabViewItem>
                        </TabView>
                    </StackPanel>
                </TabViewItem>
            </TabView>
        </StackPanel>
    </ScrollViewer>
</Window>
