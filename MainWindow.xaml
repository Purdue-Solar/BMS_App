<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="BMSManagerRebuilt.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BMSManagerRebuilt"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    xmlns:ScottPlot="using:ScottPlot.WinUI">


    <ScrollViewer x:Name="MyScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
        <StackPanel Background="DimGray">
            <Grid>
                <TextBlock Text="PSR BMS GUI ver 1.0.0" Foreground="Orange" FontWeight="Bold" FontSize="30" FontFamily="Times New Roman" VerticalAlignment="Top" HorizontalAlignment="Left"/>
                <Button HorizontalAlignment="Right" Margin="0,0,100,0" Width="100" BorderBrush="Black" Background="Gray">Imports</Button>
                <Button HorizontalAlignment="Right" Width="100" BorderBrush="Black" Background="Gray" Click="ExportButton_Click">Export</Button>
            </Grid>
            <TabView IsAddTabButtonVisible="False">
                <TabViewItem Header="PARAMs CONFIGURATION" HorizontalContentAlignment="Center" Background="Gray" Foreground="White" IsClosable="False">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="Parameters Configuration" Foreground="AntiqueWhite" FontWeight="Bold" FontSize="30" HorizontalAlignment="Center" HorizontalTextAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <CheckBox x:Name="IsoCheckBox" Checked="IsoCheckBox_Checked" Unchecked="IsoCheckBox_Unchecked" Margin="0,-5,-90,0" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Isolation Limits" Foreground="FloralWhite" FontSize="17" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,15,0"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <StackPanel Orientation="Vertical">
                                        <TextBlock Text="Isolation Resistance" VerticalAlignment="Center" HorizontalTextAlignment="Center" HorizontalAlignment="Center" Margin="25,10,25,0" />
                                        <TextBlock Text="Isolation Resistance &#10;Warning" VerticalAlignment="Center" HorizontalAlignment="Center" HorizontalTextAlignment="Center" Margin="25,15,25,0"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Vertical">
                                        <TextBox x:Name="BoxIsoRes" KeyDown="IsoRes_KeyDown" TextChanged="IsoRes_TextChanged" PlaceholderText="Values" Margin="5"/>
                                        <TextBox x:Name="BoxIsoResWarn" KeyDown="IsoResWarn_KeyDown" TextChanged="IsoResWarn_TextChanged" PlaceholderText="Values" Margin="5"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Vertical">
                                        <TextBlock x:Name="IsoResInd" Text="X" Margin="12" FontWeight="ExtraBold" Foreground="Red"/>
                                        <TextBlock x:Name="IsoResWarnInd" Text="X" Margin="12" FontWeight="ExtraBold" Foreground="Red"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                            <Line Stroke="Black" Y1="600" Margin="5,10,15,0"/>
                            <StackPanel Orientation="Vertical">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <CheckBox x:Name="CurrentWarnCheckBox" Checked="CurrentWarnCheckBox_Checked" Unchecked="CurrentWarnCheckBox_Unchecked" Margin="0,30,-90,0" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Current Warning limit" Foreground="FloralWhite" FontSize="17" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,35,15,0"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <StackPanel Orientation="Vertical">
                                        <TextBlock Text="Max Charging Warning" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10"/>
                                        <TextBlock Text="Max Charging&#10;Temperature Warning" VerticalAlignment="Center" HorizontalAlignment="Center" HorizontalTextAlignment="Center" Margin="10"/>
                                        <TextBlock Text="Max Discharging Warning" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="5"/>
                                        <TextBlock Text="Max Discharging &#10; Temperature Warning" HorizontalTextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,7,0,10"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Vertical">
                                        <TextBox x:Name="BoxCurrentWarnMaxCharge" KeyDown="CurrentWarnMaxCharge_KeyDown" TextChanged="CurrentWarnMaxCharge_TextChanged" PlaceholderText="Values" Margin="5"/>
                                        <TextBox x:Name="BoxCurrentWarnMaxChargeTemp" KeyDown="CurrentWarnMaxChargeTemp_KeyDown" TextChanged="CurrentWarnMaxChargeTemp_TextChanged" PlaceholderText="Values" Margin="5"/>
                                        <TextBox x:Name="BoxCurrentWarnMaxDischarge" KeyDown="CurrentWarnMaxDischarge_KeyDown" TextChanged="CurrentWarnMaxDischarge_TextChanged" PlaceholderText="Values" Margin="5"/>
                                        <TextBox x:Name="BoxCurrentWarnMaxDischargeTemp" KeyDown="CurrentWarnMaxDischargeTemp_KeyDown" TextChanged="CurrentWarnMaxDischargeTemp_TextChanged" PlaceholderText="Values" Margin="5"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Vertical">
                                        <TextBlock x:Name="CurrentWarnMaxChargeInd" Text="X" Margin="12" FontWeight="ExtraBold" Foreground="Red"/>
                                        <TextBlock x:Name="CurrentWarnMaxChargeTempInd" Text="X" Margin="12" FontWeight="ExtraBold" Foreground="Red"/>
                                        <TextBlock x:Name="CurrentWarnMaxDischargeInd" Text="X" Margin="12" FontWeight="ExtraBold" Foreground="Red"/>
                                        <TextBlock x:Name="CurrentWarnMaxDischargeTempInd" Text="X" Margin="12" FontWeight="ExtraBold" Foreground="Red"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <CheckBox x:Name="CurrentCheckBox" Checked="CurrentCheckBox_Checked"  Unchecked="CurrentCheckBox_Unchecked"  Margin="0,30,-90,0" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Current Limits&#10; Configuration" Foreground="FloralWhite" FontSize="17" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,20,0,0"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <StackPanel Orientation="Vertical">
                                        <TextBlock Text="Max Charging Limits" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,10,0,5"/>
                                        <TextBlock Text="Max Charging &#10;Temperature Lmits" VerticalAlignment="Center" HorizontalAlignment="Center" HorizontalTextAlignment="Center" Margin="10"/>
                                        <TextBlock Text="Max Discharging Limits" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="5"/>
                                        <TextBlock Text="Max Discharging&#10; Temperature Limits" HorizontalTextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10"/>
                                        <TextBlock Text="Max Pulse Discharge &#10;Limtis" VerticalAlignment="Center" HorizontalTextAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                                        <TextBlock Text="Max Pulse Discharge &#10; Duration Limits" HorizontalTextAlignment="Center"  VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20,0,20,0"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Vertical">
                                        <TextBox x:Name="BoxCurrentMaxCharge" KeyDown="CurrentMaxCharge_KeyDown" TextChanged="CurrentMaxCharge_TextChanged" PlaceholderText="Values" Margin="5"/>
                                        <TextBox x:Name="BoxCurrentMaxChargeTemp" KeyDown="CurrentMaxChargeTemp_KeyDown" TextChanged="CurrentMaxChargeTemp_TextChanged" PlaceholderText="Values" Margin="5"/>
                                        <TextBox x:Name="BoxCurrentMaxDischarge" KeyDown="CurrentMaxDischarge_KeyDown" TextChanged="CurrentMaxDischarge_TextChanged" PlaceholderText="Values" Margin="5"/>
                                        <TextBox x:Name="BoxCurrentMaxDischargeTemp" KeyDown="CurrentMaxDischargeTemp_KeyDown" TextChanged="CurrentMaxDischargeTemp_TextChanged" PlaceholderText="Values" Margin="5"/>
                                        <TextBox x:Name="BoxCurrentMaxPulse" KeyDown="CurrentMaxPulse_KeyDown" TextChanged="CurrentMaxPulse_TextChanged" PlaceholderText="Values" Margin="5"/>
                                        <TextBox x:Name="BoxCurrentMaxPulseDuration" KeyDown="CurrentMaxPulseDuration_KeyDown" TextChanged="CurrentMaxPulseDuration_TextChanged" PlaceholderText="Values" Margin="5"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Vertical">
                                        <TextBlock x:Name="CurrentMaxChargeInd" Text="X" Margin="12" FontWeight="ExtraBold" Foreground="Red"/>
                                        <TextBlock x:Name="CurrentMaxChargeTempInd" Text="X" Margin="12" FontWeight="ExtraBold" Foreground="Red"/>
                                        <TextBlock x:Name="CurrentMaxDischargeInd" Text="X" Margin="12" FontWeight="ExtraBold" Foreground="Red"/>
                                        <TextBlock x:Name="CurrentMaxDischargeTempInd" Text="X" Margin="12" FontWeight="ExtraBold" Foreground="Red"/>
                                        <TextBlock x:Name="CurrentMaxPulseInd" Text="X" Margin="12" FontWeight="ExtraBold" Foreground="Red"/>
                                        <TextBlock x:Name="CurrentMaxPulseDurationInd" Text="X" Margin="12" FontWeight="ExtraBold" Foreground="Red"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                            <Line Stroke="Black" Y1="600" Margin="5,10,15,0"/>
                            <StackPanel Orientation="Vertical">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <CheckBox x:Name="VoltageLimitsCheckBox" Checked="VoltageLimitsCheckBox_Checked"  Unchecked="VoltageLimitsCheckBox_Unchecked" Margin="0,0,-90,0" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Voltage Limits&#10;Configuration" Foreground="FloralWhite" FontSize="17" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,15,0"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <StackPanel Orientation="Vertical">
                                        <TextBlock Text="Max Cell Voltage" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10"/>
                                        <TextBlock Text="Min Cell Voltage" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10"/>
                                        <TextBlock Text="Max Cell Voltage &#10; Charging" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="5"/>
                                        <TextBlock Text="Max Pack Voltage" HorizontalTextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10"/>
                                        <TextBlock Text="Min Pack Voltage" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,11,0,5"/>
                                        <TextBlock Text="Max Pack Voltage &#10; Charging" HorizontalTextAlignment="Center"  VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Vertical">
                                        <TextBox x:Name="BoxVoltageMaxCell" KeyDown="VoltageMaxCell_KeyDown" TextChanged="VoltageMaxCell_TextChanged" PlaceholderText="Values" Margin="5"/>
                                        <TextBox x:Name="BoxVoltageMinCell" KeyDown="VoltageMinCell_KeyDown" TextChanged="VoltageMinCell_TextChanged" PlaceholderText="Values" Margin="5"/>
                                        <TextBox x:Name="BoxVoltageMaxCellCharge" KeyDown="VoltageMaxCellCharge_KeyDown" TextChanged="VoltageMaxCellCharge_TextChanged" PlaceholderText="Values" Margin="5"/>
                                        <TextBox x:Name="BoxVoltageMaxPack" KeyDown="VoltageMaxPack_KeyDown" TextChanged="VoltageMaxPack_TextChanged" PlaceholderText="Values" Margin="5"/>
                                        <TextBox x:Name="BoxVoltageMinPack" KeyDown="VoltageMinPack_KeyDown" TextChanged="VoltageMinPack_TextChanged" PlaceholderText="Values" Margin="5"/>
                                        <TextBox x:Name="BoxVoltageMaxPackCharge" KeyDown="VoltageMaxPackCharge_KeyDown" TextChanged="VoltageMaxPackCharge_TextChanged" PlaceholderText="Values" Margin="5"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Vertical">
                                        <TextBlock x:Name="VoltageMaxCellInd" Text="X" Margin="12" FontWeight="ExtraBold" Foreground="Red"/>
                                        <TextBlock x:Name="VoltageMinCellInd" Text="X" Margin="12" FontWeight="ExtraBold" Foreground="Red"/>
                                        <TextBlock x:Name="VoltageMaxCellChargeInd" Text="X" Margin="12" FontWeight="ExtraBold" Foreground="Red"/>
                                        <TextBlock x:Name="VoltageMaxPackInd" Text="X" Margin="12" FontWeight="ExtraBold" Foreground="Red"/>
                                        <TextBlock x:Name="VoltageMinPackInd" Text="X" Margin="12" FontWeight="ExtraBold" Foreground="Red"/>
                                        <TextBlock x:Name="VoltageMaxPackChargeInd" Text="X" Margin="12" FontWeight="ExtraBold" Foreground="Red"/>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <CheckBox x:Name="VoltageWarningCheckBox" Checked="VoltageWarningCheckBox_Checked"  Unchecked="VoltageWarningCheckBox_Unchecked"  Margin="0,15,-90,0" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Voltage Warning&#10; Configuration" Foreground="FloralWhite" FontSize="17" FontWeight="Bold" HorizontalAlignment="Center" HorizontalTextAlignment="Center" Margin="0,10,20,0"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <StackPanel Orientation="Vertical">
                                        <TextBlock Text="Max Cell Warning" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10"/>
                                        <TextBlock Text="Min Cell Warning" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10"/>
                                        <TextBlock Text="Max Cell Warning&#10;Charging" VerticalAlignment="Center" HorizontalAlignment="Center" HorizontalTextAlignment="Center" Margin="5"/>
                                        <TextBlock Text="Max Pack Warning" HorizontalTextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10"/>
                                        <TextBlock Text="Min Pack Warning" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,11,0,5"/>
                                        <TextBlock Text="Max Pack Warning&#10; Charging" HorizontalTextAlignment="Center"  VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Vertical">
                                        <TextBox x:Name="BoxVoltageWarnMaxCell" KeyDown="VoltageWarnMaxCell_KeyDown" TextChanged="VoltageWarnMaxCell_TextChanged" PlaceholderText="Values" Margin="5"/>
                                        <TextBox x:Name="BoxVoltageWarnMinCell" KeyDown="VoltageWarnMinCell_KeyDown" TextChanged="VoltageWarnMinCell_TextChanged"  PlaceholderText="Values" Margin="5"/>
                                        <TextBox x:Name="BoxVoltageWarnMaxCellCharge" KeyDown="VoltageWarnMaxCellCharge_KeyDown" TextChanged="VoltageWarnMaxCellCharge_TextChanged" PlaceholderText="Values" Margin="5"/>
                                        <TextBox x:Name="BoxVoltageWarnMaxPack" KeyDown="VoltageWarnMaxPack_KeyDown" TextChanged="VoltageWarnMaxPack_TextChanged" PlaceholderText="Values" Margin="5"/>
                                        <TextBox x:Name="BoxVoltageWarnMinPack" KeyDown="VoltageWarnMinPack_KeyDown" TextChanged="VoltageWarnMinPack_TextChanged" PlaceholderText="Values" Margin="5"/>
                                        <TextBox x:Name="BoxVoltageWarnMaxPackCharge" KeyDown="VoltageWarnMaxPackCharge_KeyDown" TextChanged="VoltageWarnMaxPackCharge_TextChanged" PlaceholderText="Values" Margin="5"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Vertical">
                                        <TextBlock x:Name="VoltageWarnMaxCellInd" Text="X" Margin="12" FontWeight="ExtraBold" Foreground="Red"/>
                                        <TextBlock x:Name="VoltageWarnMinCellInd" Text="X" Margin="12" FontWeight="ExtraBold" Foreground="Red"/>
                                        <TextBlock x:Name="VoltageWarnMaxCellChargeInd" Text="X" Margin="12" FontWeight="ExtraBold" Foreground="Red"/>
                                        <TextBlock x:Name="VoltageWarnMaxPackInd" Text="X" Margin="12" FontWeight="ExtraBold" Foreground="Red"/>
                                        <TextBlock x:Name="VoltageWarnMinPackInd" Text="X" Margin="12" FontWeight="ExtraBold" Foreground="Red"/>
                                        <TextBlock x:Name="VoltageWarnMaxPackChargeInd" Text="X" Margin="12" FontWeight="ExtraBold" Foreground="Red"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </TabViewItem>

                <TabViewItem Header="CONTACTOR CONFIGURATION" HorizontalContentAlignment="Center" Background="Gray" Foreground="White" IsClosable="False">
                    <StackPanel>
                        <TextBlock Text="Contactor Configuration" Foreground="AntiqueWhite" FontWeight="Bold" FontSize="30" HorizontalAlignment="Center" HorizontalTextAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <StackPanel Orientation="Vertical">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <CheckBox x:Name="MainHighCheckBox" Checked="MainHighCheckBox_Checked"  Unchecked="MainHighCheckBox_Unchecked"  Margin="0,-5,-90,0" HorizontalAlignment="Center"/>
                                    <TextBlock Text= "MAIN HIGH SIDE" HorizontalTextAlignment="Center" HorizontalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <StackPanel Orientation="Vertical">

                                        <TextBlock Text="Index" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10"/>
                                        <TextBlock Text="Flag" VerticalAlignment="Center" HorizontalAlignment="Center" HorizontalTextAlignment="Center" Margin="10,15,10,0"/>
                                        <TextBlock Text="Hold Delay Ms" HorizontalTextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10,23,10,0"/>
                                        <TextBlock Text="Hold Duty Cycle" HorizontalTextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10,25,10,0"/>
                                        <TextBlock Text="Pull in Duty Cycle" HorizontalTextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10,25,10,0"/>

                                    </StackPanel>
                                    <StackPanel Orientation="Vertical">
                                        <TextBox x:Name="BoxMainHighIndex" KeyDown="MainHighIndex_KeyDown" TextChanged="MainHighIndex_TextChanged" PlaceholderText="Values" Margin="5"/>
                                        <TextBox x:Name="BoxMainHighFlag" KeyDown="MainHighFlag_KeyDown" TextChanged="MainHighFlag_TextChanged" PlaceholderText="Values" Margin="5"/>
                                        <TextBox x:Name="BoxMainHighHoldDelay" KeyDown="MainHighHoldDelay_KeyDown" TextChanged="MainHighHoldDelay_TextChanged" PlaceholderText="Values" Margin="5"/>
                                        <TextBox x:Name="BoxMainHighHoldDuty" KeyDown="MainHighHoldDuty_KeyDown" TextChanged="MainHighHoldDuty_TextChanged" PlaceholderText="Values" Margin="5"/>
                                        <TextBox x:Name="BoxMainHighPullDuty" KeyDown="MainHighPullDuty_KeyDown" TextChanged="MainHighPullDuty_TextChanged" PlaceholderText="Values" Margin="5"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Vertical">
                                        <TextBlock x:Name="MainHighIndexInd" Text="X" Margin="12" FontWeight="ExtraBold" Foreground="Red"/>
                                        <TextBlock x:Name="MainHighFlagInd" Text="X" Margin="12" FontWeight="ExtraBold" Foreground="Red"/>
                                        <TextBlock x:Name="MainHighHoldDelayInd" Text="X" Margin="12" FontWeight="ExtraBold" Foreground="Red"/>
                                        <TextBlock x:Name="MainHighHoldDutyInd" Text="X" Margin="12" FontWeight="ExtraBold" Foreground="Red"/>
                                        <TextBlock x:Name="MainHighPullDutyInd" Text="X" Margin="12" FontWeight="ExtraBold" Foreground="Red"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>

