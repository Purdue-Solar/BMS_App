                                        <TextBox x:Name="BoxMainLowFlag" KeyDown="MainLowFlag_KeyDown" TextChanged="MainLowFlag_TextChanged" PlaceholderText="Values" Margin="5"/>
                                        <TextBox x:Name="BoxMainLowHoldDelay" KeyDown="MainLowHoldDelay_KeyDown" TextChanged="MainLowHoldDelay_TextChanged" PlaceholderText="Values" Margin="5"/>
                                        <TextBox x:Name="BoxMainLowHoldDuty" KeyDown="MainLowHoldDuty_KeyDown" TextChanged="MainLowHoldDuty_TextChanged" PlaceholderText="Values" Margin="5"/>
                                        <TextBox x:Name="BoxMainLowPullDuty" KeyDown="MainLowPullDuty_KeyDown" TextChanged="MainLowPullDuty_TextChanged" PlaceholderText="Values" Margin="5"/>
