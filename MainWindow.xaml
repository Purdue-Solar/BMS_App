                                        <TextBlock x:Name="MainLowHoldDutyInd" Text="X" Margin="12" FontWeight="ExtraBold" Foreground="Red"/>
                                        <TextBlock x:Name="MainLowPullDutyInd" Text="X" Margin="12" FontWeight="ExtraBold" Foreground="Red"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>

