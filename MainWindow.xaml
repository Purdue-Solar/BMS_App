                                    <CheckBox x:Name="ChargeCheckBox" Checked="ChargeCheckBox_Checked"  Unchecked="ChargeCheckBox_Unchecked" Margin="0,-5,-90,0" HorizontalAlignment="Center"/>
                                    <TextBlock Text= "CHARGE" HorizontalTextAlignment="Center" HorizontalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <StackPanel Orientation="Vertical">

                                        <TextBlock Text="Index" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10"/>
                                        <TextBlock Text="Flag" VerticalAlignment="Center" HorizontalAlignment="Center" HorizontalTextAlignment="Center" Margin="10,15,10,0"/>
                                        <TextBlock Text="Hold Delay Ms" HorizontalTextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10,23,10,0"/>
                                        <TextBlock Text="Hold Duty Cycle" HorizontalTextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10,25,10,0"/>
                                        <TextBlock Text="Pull in Duty Cycle" HorizontalTextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10,25,10,0"/>

