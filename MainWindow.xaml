                            <StackPanel Orientation="Vertical">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <CheckBox x:Name="MainLowCheckBox" Checked="MainLowCheckBox_Checked"  Unchecked="MainLowCheckBox_Unchecked"  Margin="0,-5,-90,0" HorizontalAlignment="Center"/>
